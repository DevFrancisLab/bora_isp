# Optional map tile overrides. The dashboard works with no keys:
#   Street    — CARTO Dark Matter (OpenStreetMap data)
#   Satellite — Esri World Imagery
# Set a full tile URL template ({z}/{x}/{y}) only if you want another provider.
# Example (MapTiler — replace YOUR_KEY, do not commit the real key):
# VITE_MAP_STREET_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_SATELLITE_URL=https://api.maptiler.com/tiles/satellite-v2/{z}/{x}/{y}.jpg?key=YOUR_KEY
VITE_MAP_STREET_URL=
VITE_MAP_SATELLITE_URL=
