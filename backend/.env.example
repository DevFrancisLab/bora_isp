DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app,.ngrok-free.dev,.ngrok.io
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Africa's Talking SMS. Leave the sender ID empty unless the sandbox app requires one.
AFRICASTALKING_USERNAME=your_sandbox_username
AFRICASTALKING_API_KEY=your_sandbox_api_key
AFRICASTALKING_ENV=sandbox
AFRICASTALKING_SMS_SENDER_ID=

# AI Operations Assistant. Leave both blank to keep the dashboard working without Groq.
# Set GROQ_MODEL to a model id from your Groq console, for example llama-3.3-70b-versatile.
GROQ_API_KEY=
GROQ_MODEL=
